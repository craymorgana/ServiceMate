# Required. Connection string from your MongoDB host.
MONGODB_URI=

# Required. Random string of at least 32 characters. Do not commit a real value.
SECRET=

# Server port. Defaults to 3001.
PORT=3001

# Comma-separated browser origins allowed to call GraphQL.
# In development, http://localhost:5173 is allowed when this is empty.
CLIENT_ORIGIN=http://localhost:5173

# Set to 1 when the API runs behind a reverse proxy.
TRUST_PROXY=

# GraphQL URL for the Vite client. Defaults to /graphql, which the dev server proxies.
VITE_GRAPHQL_URL=/graphql

# Set to yes to allow npm run seed while NODE_ENV=production. Seed deletes all app data.
SEED_CONFIRM=
